    "tests/merge_guard_baseline_loader.py": {
      "sha256": "e5eb9a16c31a878f230bf1fef38b00978e092dff610f82a3c00a2c4c6ffee7e5",
      "reason": "Loads committed vendored copies of merge_guard_common.py from tests/fixtures/merge_guard_baseline/ through importlib, after a git-blob pin check. Those files have no import edge, so they are declared as extra_reads. The vendored modules import .paths through the shared package; hooks/shared/paths.py and shared/__init__.py are already in the closure.",
      "extra_reads": [
        "pact-plugin/tests/fixtures/merge_guard_baseline/**"
      ]
    },
    "tests/test_merge_guard_1140_carrier5_cert.py": {
      "sha256": "71bde42242afd11e6fd06eae077c7b83d781c73094b2b6aa96b1d85150fd7183",
      "reason": "Path(mgc.__file__).read_text() reads hooks/shared/merge_guard_common.py, a closure member that is also a seam. exec(compile(...)) runs that mutated source in a fresh module namespace and reads no file. The vendored baselines come from merge_guard_baseline_loader (reviewed separately), whose fixture directory is declared in that review's extra_reads. The flagged exec() at 227 is that in-memory mutant run. Line 225 sets __file__ on the fresh types.ModuleType it builds for that mutant, so compile() names the real source; it is not patched into any loaded module.",
      "extra_reads": []
    },
    "tests/test_merge_guard_substitution_mint.py": {
      "sha256": "1b58021a0647c14c690bd2b10100c09f98b4eefd0928bd2eb2ba3b20830d28b6",
      "reason": "Flagged sites 259-266 are the _hook/_approve rig: it runs plugin hooks (hooks/merge_guard_*.py, in the closure) with sys.executable, cwd and HOME set to the caller's root, and every caller passes tmp_path. os.environ.get('PATH') only forwards the search path. It reads and writes nothing outside tmp_path and the plugin hooks. Line 1765 patches gh.check_pr_state with a lambda that records the cwd it is asked about and returns `state`, a PR-state literal ('MERGED' or 'OPEN') from the test's parametrize.",
      "extra_reads": []
    },
    "tests/test_pin_growth_populations.py": {
      "sha256": "191aaf7cab7db018a707210f3b7647de03a79c69405d08e2030967a8aa6c0312",
      "reason": "os.environ.get('CI') chooses the slice or the full sweep; it reads no file. PACT_PIN_GROWTH_REAL_FILES and TRIM_DIFFERENTIAL are opt-in, operator-named inputs that are skipped when unset, which they are in both CI lanes. The real-files arm reads the CLAUDE.md files the operator names, never checkout files (it asserts none are test fixtures). Everything else is the population generators in fixtures/pin_growth (closure). Line 333 runs `python -c` with cwd=TESTS (the plugin's tests dir). The code only imports fixtures.pin_growth.generators (closure) and prints digests under a fixed PYTHONHASHSEED; it reads no file. Line 156 swaps each clause function in CLAUSES (a literal tuple) for spy(), a wrapper defined in the same function that calls the original and counts the result; it injects no location.",
      "extra_reads": []
    },
    "tests/test_telegram_tools.py": {
      "sha256": "22a35ea4392134b2140db2d0b854d24a20a69520ee1b01b3beaadeae40fed48f",
      "reason": "loop.close() and ctx.close() close asyncio loops and the reply context, not files. Every patch site injects one of three things: telegram.tools._ctx set to ctx, a ToolContext() built with no arguments (its fields start as None) whose client, voice, config and pending_replies the test sets to AsyncMock/MagicMock, plain dicts and time.time(); os.environ via patch.dict with a fake CLAUDE_PROJECT_DIR or HOME string; or os.getcwd returning a fake path. The only reader of the environment and getcwd values is _get_project_name in telegram/tools.py, which takes os.path.basename of them and opens nothing. expanduser('~') builds the fake-home string the same way. Nothing is read from disk. Attribute writes set ctx fields and mock behaviour on those mocks: side_effect to a TelegramAPIError instance, config to a dict of mode and warning strings.",
      "extra_reads": []
    }
  },
