+++ b/pricing/strategies.py
@@ -0,0 +1,105 @@
+"""Discount strategies for the pricing service.
+
+A strategy is a small, stateless object exposing a human-readable name and an
+amount_cents(order) method. New discount rules only need to subclass
+DiscountStrategy; the policy and checkout code do not change.
+"""
+
+from __future__ import annotations
+
+from abc import ABC, abstractmethod
+
+from .models import Order
+
+TIER_PERCENT: dict[str, int] = {"standard": 0, "silver": 5, "gold": 10}
+COUPON_PERCENT: dict[str, int] = {"SAVE10": 10}
+DEFAULT_BULK_MIN_UNITS = 10
+DEFAULT_BULK_PERCENT = 15
+
+
+def percent_off_cents(subtotal_cents: int, percent: int) -> int:
+    """Return 'percent' of 'subtotal_cents', rounded down to whole cents."""
+    return subtotal_cents * percent // 100
+
+
+class DiscountStrategy(ABC):
+    """Base class for order discount rules."""
+
+    name: str = "unnamed"
+
+    @abstractmethod
+    def amount_cents(self, order: Order) -> int:
+        """Return the absolute discount in whole cents for the order."""
+
+
+class NoDiscount(DiscountStrategy):
+    """Strategy that never discounts."""
+
+    name = "none"
+
+    def amount_cents(self, order: Order) -> int:
+        return 0
+
+
+class PercentDiscount(DiscountStrategy):
+    """Fixed percentage off the order subtotal."""
+
+    name = "percent"
+
+    def __init__(self, name: str, percent: int) -> None:
+        if not isinstance(name, str) or not name:
+            raise ValueError("name must be a non-empty string")
+        if isinstance(percent, bool) or not isinstance(percent, int):
+            raise ValueError("percent must be an integer between 0 and 100")
+        if not 0 <= percent <= 100:
+            raise ValueError("percent must be an integer between 0 and 100")
+        self.name = name
+        self.percent = percent
+
+    def amount_cents(self, order: Order) -> int:
+        return percent_off_cents(order.subtotal_cents, self.percent)
+
+
+class TierDiscount(DiscountStrategy):
+    """Loyalty-tier percentage discount."""
+
+    name = "tier"
+
+    def amount_cents(self, order: Order) -> int:
+        percent = TIER_PERCENT.get(order.customer_tier, 0)
+        return percent_off_cents(order.subtotal_cents, percent)
+
+
+class CouponDiscount(DiscountStrategy):
+    """Coupon-code percentage discount."""
+
+    name = "coupon"
+
+    def amount_cents(self, order: Order) -> int:
+        percent = COUPON_PERCENT.get(order.coupon or "", 0)
+        return percent_off_cents(order.subtotal_cents, percent)
+
+
+class BulkOrder(DiscountStrategy):
+    """Percentage discount for orders with enough total units."""
+
+    name = "bulk"
+
+    def __init__(
+        self,
+        min_units: int = DEFAULT_BULK_MIN_UNITS,
+        percent: int = DEFAULT_BULK_PERCENT,
+    ) -> None:
+        if isinstance(min_units, bool) or not isinstance(min_units, int) or min_units < 1:
+            raise ValueError("min_units must be a positive integer")
+        if isinstance(percent, bool) or not isinstance(percent, int):
+            raise ValueError("percent must be an integer between 0 and 100")
+        if not 0 <= percent <= 100:
+            raise ValueError("percent must be an integer between 0 and 100")
+        self.min_units = min_units
+        self.percent = percent
+
+    def amount_cents(self, order: Order) -> int:
+        if order.total_units < self.min_units:
+            return 0
+        return percent_off_cents(order.subtotal_cents, self.percent)
