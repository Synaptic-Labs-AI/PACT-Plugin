@@ -0,0 +1,61 @@
+"""Discount policy: pick the best applicable discount strategy."""
+
+from __future__ import annotations
+
+from collections.abc import Iterable
+from dataclasses import dataclass
+
+from .models import Order
+from .strategies import (
+    BulkOrder,
+    CouponDiscount,
+    DiscountStrategy,
+    NoDiscount,
+    TierDiscount,
+)
+
+
+@dataclass(frozen=True)
+class DiscountDetails:
+    strategy_name: str
+    amount_cents: int
+
+
+def _default_strategies() -> tuple[DiscountStrategy, ...]:
+    return (TierDiscount(), CouponDiscount(), BulkOrder(), NoDiscount())
+
+
+class DiscountPolicy:
+    """Evaluates discount strategies and keeps the single best discount."""
+
+    def __init__(self, strategies: Iterable[DiscountStrategy] | None = None) -> None:
+        if strategies is None:
+            self.strategies: tuple[DiscountStrategy, ...] = _default_strategies()
+            return
+        resolved = tuple(strategies)
+        for strategy in resolved:
+            if not isinstance(strategy, DiscountStrategy):
+                raise TypeError("discount strategies must be DiscountStrategy instances")
+        self.strategies = resolved
+
+    def discount_details(self, order: Order) -> DiscountDetails:
+        subtotal = order.subtotal_cents
+        best_name = "none"
+        best_amount = 0
+        for strategy in self.strategies:
+            amount = strategy.amount_cents(order)
+            if isinstance(amount, bool) or not isinstance(amount, int):
+                raise TypeError("amount_cents() must return a whole number of cents")
+            clamped = min(max(amount, 0), subtotal)
+            if clamped > best_amount:
+                best_amount = clamped
+                best_name = strategy.name
+        return DiscountDetails(strategy_name=best_name, amount_cents=best_amount)
+
+    def discount_cents(self, order: Order) -> int:
+        return self.discount_details(order).amount_cents
+
+
+def default_policy() -> DiscountPolicy:
+    """Return a fresh policy with the default rule order."""
+    return DiscountPolicy()
diff --git a/pricing/strategies.py b/pricing/strategies.py
