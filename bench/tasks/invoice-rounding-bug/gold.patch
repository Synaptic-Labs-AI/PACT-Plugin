@@ -0,0 +1,34 @@
+from decimal import Decimal
+
+import pytest
+
+from invoice import apply_discount, invoice_totals, round_cents, tax_amount
+
+
+@pytest.mark.parametrize(
+    ("raw", "expected"),
+    [("0.5", 1), ("2.5", 3), ("50.5", 51), ("52.5", 53)],
+)
+def test_round_cents_rounds_exact_halves_up(raw, expected):
+    assert round_cents(Decimal(raw)) == expected
+
+
+def test_tax_amount_rounds_half_cents_up():
+    assert tax_amount(1010, 5) == 51
+    assert tax_amount(1050, 5) == 53
+    assert tax_amount(200, "8.25") == 17
+
+
+def test_apply_discount_rounds_half_cents_up():
+    assert apply_discount(1005, 10) == 101
+    assert apply_discount(1030, 5) == 52
+
+
+def test_invoice_totals_matches_reported_example():
+    assert invoice_totals(1005, 10, 10) == {
+        "subtotal": 1005,
+        "discount": 101,
+        "taxable": 904,
+        "tax": 90,
+        "total": 994,
+    }
