#!/usr/bin/env python3
"""PACT benchmark CLI.

Dispatches the harness subcommands: prepare, native-eval, plugin-eval and
tasks validate. Each subcommand's --help is its own argparse help.
"""
from __future__ import annotations

import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))

from external.runner import native_eval, plugin_eval, prepare  # noqa: E402
from tasks.validate import main as tasks_validate_main  # noqa: E402

USAGE = """usage: pact-bench prepare [args]
       pact-bench native-eval [args]
       pact-bench plugin-eval [args]
       pact-bench tasks validate [args]

Run any subcommand with --help for its arguments."""


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    if not args or args[0] in ("-h", "--help"):
        print(USAGE)
        return 0
    command, rest = args[0], args[1:]
    if command == "prepare":
        return prepare.main(rest)
    if command == "native-eval":
        return native_eval.main(rest)
    if command == "plugin-eval":
        return plugin_eval.main(rest)
    if command == "tasks":
        if rest and rest[0] == "validate":
            return tasks_validate_main(rest[1:])
        print("usage: pact-bench tasks validate [args]", file=sys.stderr)
        return 2
    print(f"unknown command: {command}", file=sys.stderr)
    print(USAGE, file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
