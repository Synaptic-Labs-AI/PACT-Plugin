#!/usr/bin/env python3
"""PACT benchmark CLI.

Currently dispatches preparation/verification. External tool orchestration,
comparison, and report generation are added as the harness grows.
"""
from __future__ import annotations

import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
sys.path.insert(0, str(HERE))

from external.runner import native_eval, plugin_eval, prepare  # noqa: E402
sys.path.insert(0, str(HERE / "tasks"))
from validate import main as tasks_validate_main  # noqa: E402


def main(argv: list[str] | None = None) -> int:
    args = list(sys.argv[1:] if argv is None else argv)
    if not args or args[0] in ("-h", "--help"):
        print("usage: pact-bench prepare [args]")
        print("       pact-bench compare --baseline <dir> --current <dir>")
        print("       pact-bench report --suite <dir>")
        return 0
    command, rest = args[0], args[1:]
    if command == "prepare":
        return prepare.main(rest)
    if command == "native-eval":
        return native_eval.main(rest)
    if command == "plugin-eval":
        return plugin_eval.main(rest)
    if command == "tasks":
        if rest and rest[0] == "validate":
            return tasks_validate_main(rest[1:])
        print("usage: pact-bench tasks validate [--all]", file=sys.stderr)
        return 2
    if command == "compare":
        print("compare is not implemented yet", file=sys.stderr)
        return 2
    if command == "report":
        print("report is not implemented yet", file=sys.stderr)
        return 2
    print(f"unknown command: {command}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
